{
  "name": "@trimetaverse/tricode",
  "version": "0.2.0-wave3",
  "private": true,
  "description": "TriMetaverse Code Tool Glue — unified code execution interface across opencode / Claude Code / Codex / zcode / Copilot（0.2.0-wave3：+trimodel-cli core，TASK-TRIMODEL-RECOVERY-LADDER-01 波③）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./trimodel-cli": {
      "import": "./dist/trimodel-cli/index.js",
      "require": "./dist/trimodel-cli/index.js",
      "types": "./dist/trimodel-cli/index.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
